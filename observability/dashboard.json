{
  "id": null,
  "uid": "jade-demo",
  "title": "JaDe Blockchain — demostración",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Eventos por nodo",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "jade-prometheus" },
      "targets": [{ "expr": "jade_events_total", "legendFormat": "{{node}}" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Eventos pendientes de ancla por nodo",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "jade-prometheus" },
      "targets": [{ "expr": "jade_pending_events", "legendFormat": "{{node}}" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Retraso de anclaje por nodo (segundos)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "jade-prometheus" },
      "targets": [{ "expr": "jade_anchor_delay_seconds", "legendFormat": "{{node}}" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Capacidad de firma y salud de captura por nodo",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "jade-prometheus" },
      "targets": [
        { "expr": "jade_signer_ready", "legendFormat": "firmador {{node}}" },
        { "expr": "jade_capture_healthy", "legendFormat": "captura {{node}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 5,
      "title": "Integridad global y eventos sin firma por nodo",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "jade-prometheus" },
      "targets": [
        { "expr": "jade_integrity_ok", "legendFormat": "integridad {{node}}" },
        { "expr": "jade_events_unsigned", "legendFormat": "sin firma {{node}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },
    {
      "id": 6,
      "title": "Anclas rechazadas / errores de anclaje por nodo",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "jade-prometheus" },
      "targets": [
        { "expr": "jade_anchor_rejected", "legendFormat": "{{node}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    }
  ]
}
