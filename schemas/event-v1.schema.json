{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dereck2102/jade_blockchain/blob/main/schemas/event-v1.schema.json",
  "title": "JaDe Blockchain Signed Event v1",
  "type": "object",
  "required": [
    "fecha",
    "nodo",
    "origen",
    "tipo",
    "nivel",
    "hash_anterior",
    "hash",
    "firma",
    "firma_n"
  ],
  "properties": {
    "fecha": { "type": "string", "minLength": 1 },
    "nodo": { "type": "string", "minLength": 1 },
    "origen": { "type": "string", "minLength": 1 },
    "tipo": { "type": "string", "minLength": 1 },
    "nivel": { "type": "string", "minLength": 1 },
    "hash_anterior": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "firma": {
      "type": "string",
      "minLength": 86,
      "maxLength": 88
    },
    "firma_n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "datos": { "type": "object" }
  },
  "additionalProperties": true
}
